# Godot 4+
.godot/
*.tmp

# OS
Thumbs.db
.DS_Store

# Python (tools/)
__pycache__/
*.pyc
.venv/

# AI 생성 원본(raw)은 대용량 — 게이트 통과분(atlas)만 커밋
assets/raw/*
!assets/raw/.gdignore

# 참조 자료 임포트 사이드카 제외
assets/originals_ref/**/*.import

# 리터칭 샘플 Godot 임포트 메타데이터
assets/gen/viewers/samples/*.import

# 프롬프트 패키지 Godot 임포트 메타데이터
assets/gen/prompts/*.import

# 번역 임포트 산출물(ui.csv에서 재생성)
*.translation

# 현황판 — tools/dev/make_dashboard.py가 저장소 상태에서 다시 굽는다(스냅샷을 커밋하면 낡는다)
현황판.html

# 층 지도 굽기 결과 — 좌표를 눈으로 짚기 위한 것(tools/dev/map_shots.tscn이 생성)
# 언제든 다시 굽는다. 뷰어는 tools/dev/map_viewer.html
tools/dev/mapshots/

# UI 캡처 굽기 결과 (tools/dev/ui_shots.tscn이 생성)
tools/dev/ui_captures/

