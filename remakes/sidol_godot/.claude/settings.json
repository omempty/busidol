{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(python -X utf8 tools/*)",
      "Bash(python -c import ast*)",
      "Bash(python -m json.tool*)",
      "Bash(python --version)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)",
      "Bash(git branch --list*)",
      "Bash(git stash list*)",
      "Bash(node --check*)",
      "Bash(node --version)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -sS http://127.0.0.1:*)",
      "Bash(curl -sv http://127.0.0.1:*)",
      "Bash(curl -s -o /dev/null*)",
      "Bash(curl -I http://127.0.0.1:*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(find . *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/*)",
      "Bash(grep *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(awk *)",
      "Bash(tr *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(diff *)",
      "Bash(true)",
      "Bash(rg *)",
      "Bash(git rev-parse*)",
      "Bash(cp *)",
      "Bash(mkdir -p *)",
      "Bash(python - *)",
      "Bash(python -X utf8 - *)",
      "Bash(node -e *)",
      "Bash(taskkill *)"
    ]
  }
}
