{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dosport/schemas/audio_spec.schema.json",
  "title": "AI 생성 오디오(BGM/SFX) 계약서 v1 (docs/02_design/07_ai_asset_pipeline.md §5)",
  "type": "object",
  "required": ["schema_version", "tracks"],
  "properties": {
    "schema_version": { "const": 1 },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^(bgm|sfx|voice)_[a-z0-9_]+$" },
          "kind": { "enum": ["bgm_loop", "sfx_one_shot", "voice_sample"] },
          "mood_tags": { "type": "array", "items": { "type": "string" } },
          "bpm_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "duration_sec": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "loop": { "enum": ["seamless_required", "none"] },
          "instrumentation": { "type": "string" },
          "mix_target_lufs": { "type": "number" },
          "prompt_brief": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
