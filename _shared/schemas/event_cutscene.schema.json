{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dosport/schemas/event_cutscene.schema.json",
  "title": "컷신/이벤트 명령열 골격 v1 — op 어휘는 프로젝트별 레지스트리로 확장 (docs/02_design/05_toolchain_editors.md §3)",
  "type": "object",
  "required": ["id", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "actors": { "type": "object" },
    "skippable": { "type": "boolean" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": { "op": { "type": "string", "pattern": "^[a-z_]+$" } },
        "additionalProperties": true
      }
    }
  }
}
